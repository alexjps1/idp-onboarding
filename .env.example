# Copy to .env.local and fill in a real key.
OPENAI_API_KEY=sk-your-key-here
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_CONTENT_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=cedar

# Set to "true" to type to the voice agent instead of speaking (no mic prompt).
# Leave unset/false for the real microphone (e.g. on the study iPad).
NEXT_PUBLIC_REALTIME_TEXT_INPUT=false

# "api" (default): /api/simstate reads whatever SilabServer.java last pushed
# to /api/silab-ingest. "tcp": /api/simstate polls FS-SCENERY directly over
# its TCP socket (SILAB_ADDR) instead - use this if the push path to
# alexjps.com isn't reachable and this server is running on the same local
# network as FS-SCENERY.
SILAB_COMMUNICATION_MODE=api

# host:port of the SILAB TCP server (FS-SCENERY). Only used when
# SILAB_COMMUNICATION_MODE=tcp.
SILAB_ADDR=10.152.238.2:4200

# Shared secret SilabServer.java sends with every /api/silab-ingest push and
# in its TCP "simstate" response. Must match INGEST_SECRET in
# silab_config/java/SilabServer.java exactly.
SILAB_INGEST_SECRET=changeme
