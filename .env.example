# Copy to .env.local and fill in a real key.
OPENAI_API_KEY=sk-your-key-here
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_CONTENT_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=cedar

# Set to "true" to type to the voice agent instead of speaking (no mic prompt).
# Leave unset/false for the real microphone (e.g. on the study iPad).
NEXT_PUBLIC_REALTIME_TEXT_INPUT=false
